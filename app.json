{
  "expo": {
    "name": "UT Compass",
    "slug": "UT-Compass",
    "scheme": "utcompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "origin": false,
        "src": "src"
      },
      "eas": {
        "projectId": "9dfb729c-ba6a-44a7-a5f3-dd24b7c2423b"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows your current position on the campus map to help you find nearby university buildings, food, and more."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 90,
          "resizeMode": "contain",
          "backgroundColor": "#bf5700",
          "dark": {
            "image": "./assets/icon-border.png",
            "backgroundColor": "#bf5700"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.ryanling07.UT-Compass",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "mailto",
          "comgooglemaps",
          "waze",
          "transit",
          "moovit",
          "citymapper",
          "uber",
          "lyft",
          "yandexnavi",
          "osmandmaps",
          "mapsme",
          "dgis"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ryanling07.utcompass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#bf5700"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
